scripts: {
	pre-install = <<EOD
if [ -z "$(getent group cctvwriters)" ];
then
       pw groupadd cctvwriters
fi

if [ -z "$(getent group cctvviewers)" ];
then
       pw groupadd cctvviewers
fi

if [ -z "$(getent passwd bigbrother)" ];
then
        pw adduser bigbrother -g cctvwriters -d /nonexistent -s /usr/sbin/nologin -c "bigbrotherd user"
fi
EOD;

	post-install =  <<EOD
mkdir -p /usr/local/etc/rc.d
ln -s /usr/local/bigbrother/rc.bigbrotherd /usr/local/etc/rc.d/bigbrotherd
echo 'To start BigBrother at boot time add bigbrotherd_enable="YES" and bigbrotherd_conf="/path/to/conf.file" to /etc/rc.conf'
chown -R bigbrother:cctvwriters /usr/local/bigbrother
chown -R bigbrother:cctvviewers /usr/local/bigbrother/mirrorwebroot
chmod 755 /usr/local/bigbrother
chmod 750 /usr/local/bigbrother/mirrorwebroot
chmod g+s /usr/local/bigbrother/mirrorwebroot
mkdir /usr/local/bigbrother/mirrorwebroot/snapshots
chown -R bigbrother:cctvviewers /usr/local/bigbrother/mirrorwebroot/snapshots
chmod 770 /usr/local/bigbrother/mirrorwebroot/snapshots
chmod g+s /usr/local/bigbrother/mirrorwebroot/snapshots
chown -R bigbrother:cctvwriters /usr/local/bigbrother/onnx
chown -R bigbrother:cctvwriters /usr/local/bigbrother/octaquad
chmod 750 /usr/local/bigbrother/onnx
chmod 750 /usr/local/bigbrother/octaquad
chmod 740 /usr/local/bigbrother/octaquad/*
EOD;

	post-deinstall = <<EOD
# Remove runtime-generated files and directories.
if [ -d /usr/local/bigbrother/mirrorwebroot/snapshots ]; then
        find /usr/local/bigbrother/mirrorwebroot/snapshots -mindepth 1 -delete
        rmdir /usr/local/bigbrother/mirrorwebroot/snapshots 2>/dev/null || true
fi
# Remove Python bytecode caches created at runtime.
find /usr/local/bigbrother/octaquad -type d -name __pycache__ -prune -exec rm -rf {} +
#Remove event log file
rm /usr/local/bigbrother/mirrorwebroot/org.bigbrothercctv.bigbrother.aieventlog.txt
rm /usr/local/etc/rc.d/bigbrotherd
echo "You will need to manually remove the log file and config files if they were not in /usr/local/bigbrother"
echo "and also any bigbrotherd_ entries in /etc/rc.conf"
pw userdel bigbrother
pw groupdel cctvwriters
pw groupdel cctvviewers
EOD;
}

