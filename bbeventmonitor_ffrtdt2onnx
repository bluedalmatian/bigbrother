def loadModel(model_bytes):
    #try each available execution provider in order of preference, use the first that
    #loads the model and passes a test run
    available = ort.get_available_providers()
    candidates = []
    if "OpenVINOExecutionProvider" in available:
        candidates.append([("OpenVINOExecutionProvider", {"device_type": "NPU"})])
    if "CoreMLExecutionProvider" in available:
        candidates.append(["CoreMLExecutionProvider"])
    if "VitisAIExecutionProvider" in available:
        candidates.append(["VitisAIExecutionProvider"])
    if "CUDAExecutionProvider" in available:
        candidates.append(["CUDAExecutionProvider"])
    if "MIGraphXExecutionProvider" in available:
        candidates.append(["MIGraphXExecutionProvider"])
    if "ACLExecutionProvider" in available:
        candidates.append(["ACLExecutionProvider"])
    candidates.append(["CPUExecutionProvider"])

    for providers in candidates:
        try:
            opts = ort.SessionOptions()
            opts.inter_op_num_threads = 1
            opts.add_session_config_entry("session.intra_op.allow_spinning", "0")
            if providers == ["CPUExecutionProvider","ACLExecutionProvider"]:
                opts.intra_op_num_threads = ORT_THREADS
            else:
                opts.intra_op_num_threads = 1 #accelerator does the heavy work, CPU only handles any fallback ops

            print("Trying NN exe provider:", providers)
            sess = ort.InferenceSession(model_bytes, sess_options=opts, providers=providers)
            setModelFormat(sess)
            runModel(sess, np.zeros((1, 3, 640, 640), dtype=np.float32), 640, 640)
            print("Using NN exe provider:", sess.get_providers())
            Log("Using NN exe provider: "+str(sess.get_providers()))
            print("Model inputs: "+str(MODEL_IN_NAMES)+" outputs: "+str(MODEL_OUT_NAMES))
            Log("Model inputs: "+str(MODEL_IN_NAMES)+" outputs: "+str(MODEL_OUT_NAMES))
            return sess
        except Exception as e:
            print("NN exe provider failed:", providers, str(e))
            Log("NN exe provider failed: "+str(providers)+" "+str(e))

    print("FATAL: Could not run the model with any execution provider")
    Log("FATAL: Could not run the model with any execution provider")
    exit(1)
