def unescapeTimeString(inputstr):
    #inputstr is a timestr in format "\[20:00-21:00\]" or "\[20:00-21:00\]/\[22:00-22:30\]" or "\[\*\]"
    #remove \ escape chars and return string
    outputstr=""
    for char in inputstr:
        if char!="\\":
            outputstr=outputstr+char
    return outputstr
