def reader():
    global last_frame_time
    global FRAMESIZEBYTES
    global FRAMEW
    global FRAMEH

    if nvidia:
        #use GPU
        Log("Using NVIDIA GPU for ffmpeg")
        print("Using NVIDIA GPU for ffmpeg")
        cmd = [ffmpeg_command,"-hide_banner","-loglevel", "error","-nostdin","-hwaccel", "cuda","-hwaccel_output_format", "cuda","-timeout", "10000000","-i", cameraurl,"-vf",f"fps=4,scale_cuda={FRAMEW}:{FRAMEH},hwdownload,format=bgr24","-pix_fmt", "bgr24","-f", "rawvideo","-"]
    else:
        #use CPU
        Log("Using CPU for ffmpeg")
        print("Using CPU for ffmpeg")
        cmd = [ffmpeg_command,"-hide_banner","-loglevel", "error","-nostdin","-timeout","10000000","-i", cameraurl,"-vf", "fps=5,scale="+str(FRAMEW)+":"+str(FRAMEH),"-pix_fmt", "bgr24","-f", "rawvideo","-"]

    process = None
    try:
        print("Starting ffmpeg subprocess")
        Log("Starting ffmpeg subprocess")

        process = subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=None,bufsize=1024 * 1024)
        print("subprocess ffmpeg PID:", process.pid)
        Log("subprocess ffmpeg PID:"+str(process.pid))

        buffer = b""

        while not exit_event.is_set():
            tread = time.time() 
            needed = FRAMESIZEBYTES - len(buffer)
            data = process.stdout.read(needed)
            read_time = time.time() - tread 

            if read_time > 1:
                print("WARNING: FFmpeg pipe read took", read_time, "seconds") 

            if not data:
                print("ffmpeg return code:", process.poll())
                print("ffmpeg returned no data")
                Log("ffmpeg returned no data")
                break

            buffer += data

            if len(buffer) < FRAMESIZEBYTES:
                continue

            tdecode = time.time() 
            frame = np.frombuffer(buffer, dtype=np.uint8).reshape((FRAMEH, FRAMEW, 3))
            decode_time = time.time() - tdecode 
            if decode_time > 0.5:
                print("WARNING: frame reshape took", decode_time, "seconds") 

            last_frame_time = time.time()

            try:
                frame_queue.put(frame.copy(), timeout=0)
            except:
                print("WARNING: queue full, frame dropped and will not be processed for events. This may cause events to be missed. Try increasing CPU capacity\n")
                Log("WARNING: queue full, frame dropped and will not be processed for events. This may cause events to be missed. Try increasing CPU capacity\n")

            buffer = b""

    except Exception as e:
        print("ffmpeg reader error: " + str(e))
        Log("ffmpeg reader error: " + str(e))
    finally:
        if process is not None:
            try:
                process.kill()
            except:
                pass
            try:
                process.wait(timeout=2)
            except:
                pass
        print("ffmpeg reader stopped")
        Log("ffmpeg reader stopped")
