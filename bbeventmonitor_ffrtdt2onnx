def setModelFormat(sess):
    global MODEL_IN_NAMES, MODEL_OUT_NAMES, OFFICIAL_EXPORT, RAW_EXPORT
    MODEL_IN_NAMES = [i.name for i in sess.get_inputs()]
    MODEL_OUT_NAMES = [o.name for o in sess.get_outputs()]
    OFFICIAL_EXPORT = {"labels", "boxes", "scores"}.issubset(set(MODEL_OUT_NAMES))
