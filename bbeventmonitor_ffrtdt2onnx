###############################################################################
def runModel(sess, blob, width, height):
    #Run RT-DETR model on a 640x640 blob, return (labels, boxes xyxy in frame pixels, scores)
    #Supported export formats:
    # - Official RT-DETRv2 export: inputs "images" + "orig_target_sizes" (int64 [w,h]),
    #   outputs "labels", "boxes" (xyxy in original image pixels), "scores"
    # - Raw export: outputs "pred_logits" + "pred_boxes" (cx,cy,w,h normalised 0-1)
    # - Single output: (1, num_queries, 4 + num_classes), boxes cx,cy,w,h
    if OFFICIAL_EXPORT:
        feeds = {}
        for name in MODEL_IN_NAMES:
            if "size" in name:
                feeds[name] = np.array([[width, height]], dtype=np.int64)
            else:
                feeds[name] = blob
        outs = dict(zip(MODEL_OUT_NAMES, sess.run(MODEL_OUT_NAMES, feeds)))
        labels = outs["labels"].reshape(-1).astype(int)
        boxes = outs["boxes"].reshape(-1, 4).astype(np.float32)
        scores = outs["scores"].reshape(-1).astype(np.float32)
        return labels, boxes, scores

    if RAW_EXPORT:
        a, b = sess.run(MODEL_OUT_NAMES, {MODEL_IN_NAMES[0]: blob})
        if a.shape[-1] == 4:
            raw_boxes, logits = a, b
        else:
            logits, raw_boxes = a, b
        raw_boxes = raw_boxes.reshape(-1, 4)
        probs = 1.0 / (1.0 + np.exp(-logits.reshape(raw_boxes.shape[0], -1)))   # sigmoid
        sx, sy = width, height
    else:
        pred = sess.run(None, {MODEL_IN_NAMES[0]: blob})[0]
        pred = pred.reshape(-1, pred.shape[-1])
        raw_boxes, probs = pred[:, :4], pred[:, 4:]
        if raw_boxes.max() > 2.0:
            sx, sy = width / 640, height / 640
        else:
            sx, sy = width, height

    labels = probs.argmax(axis=1).astype(int)
    scores = probs.max(axis=1).astype(np.float32)
    cx, cy, w, h = raw_boxes[:, 0], raw_boxes[:, 1], raw_boxes[:, 2], raw_boxes[:, 3]
    boxes = np.stack([(cx - w/2) * sx, (cy - h/2) * sy, (cx + w/2) * sx, (cy + h/2) * sy], axis=1)
    return labels, boxes, scores
