def ignoreEvent(times):
    now = datetime.now()
    current_minutes = now.hour * 60 + now.minute
    for txt in times:
        startendtime = splitStartEndTime(txt)
        start = splitHoursMinutes(startendtime[0])
        end = splitHoursMinutes(startendtime[1])
        start_minutes = int(start[0]) * 60 + int(start[1])
        end_minutes = int(end[0]) * 60 + int(end[1])
        print("Checking if we are within: ", txt)

        # Normal range, for example 20:00-21:00
        if start_minutes < end_minutes:

            if start_minutes <= current_minutes < end_minutes:
                return True

        # Overnight range, for example 22:00-02:00
        elif start_minutes > end_minutes:

            if current_minutes >= start_minutes or current_minutes < end_minutes:
                return True

        # start == end
        else:
            return False

    return False

